# Copy to .env.local (and add the same values in Vercel → Project → Settings → Environment Variables)

# --- Supabase (Project Settings → API). Server-only: never expose this key to the browser.
# service_role key, or the new secret key (sb_secret_…)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (hackathon key). API model ids: gpt-6-astra (strongest), gpt-6-sol, gpt-6-luna (cheapest, fastest).
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna      # job cards, invoice reading, message texts
OPENAI_MODEL_AGENT=gpt-6-luna     # only used by the fallback voice loop (/api/chat); try gpt-6-sol if tool use gets sloppy

# --- ElevenLabs
# Agent mode (preferred): create an agent in the ElevenLabs dashboard, paste its id here.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Fallback mode (if your key has text-to-speech only): leave the agent id empty and fill these.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # empty = a premade ElevenLabs voice (JBFqnCBsd6RMkjVDRZzb)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# --- Security for the agent's tool calls and the demo reset (any long random string)
AGENT_TOOL_SECRET=change-me-to-a-long-random-string

# --- Messages out (WhatsApp / email)
# log  = messages are only written to the case timeline (demo works without n8n)
# n8n  = messages are also POSTed to your n8n webhook, which sends WhatsApp / email
NOTIFY_MODE=log
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Public URL of the deployed app (used in links sent to tenants and craftsmen)
APP_BASE_URL=http://localhost:3000
